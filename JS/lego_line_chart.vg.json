{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": null,
  "width": "container",
  "height": 300,
  "data": {
    "url": "Data/lego_sets_and_themes.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year_released": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "isValid(datum.year_released) && isValid(datum.set_number) && datum.year_released >= 1949 && datum.year_released <= 2023"
    },
    {
      "aggregate": [
        {
          "op": "count",
          "as": "total_sets"
        }
      ],
      "groupby": [
        "year_released"
      ]
    }
  ],
  "encoding": {
    "x": {
      "field": "year_released",
      "type": "quantitative",
      "title": "Release Year",
      "scale": {
        "domain": [
          1949,
          2023
        ]
      },
      "axis": {
        "format": "d",
        "tickCount": 10,
        "grid": false
      }
    },
    "y": {
      "field": "total_sets",
      "type": "quantitative",
      "title": "Number of LEGO Sets Released",
      "scale": {
        "zero": true
      },
      "axis": {
        "grid": true,
        "tickCount": 6
      }
    },
    "tooltip": [
      {
        "field": "year_released",
        "type": "quantitative",
        "title": "Year",
        "format": "d"
      },
      {
        "field": "total_sets",
        "type": "quantitative",
        "title": "Sets Released",
        "format": ","
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "gridColor": "#e8e5dd"
    }
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": "transparent",
  "mark": {
    "type": "line",
    "color": "#E3000B",
    "strokeWidth": 3,
    "point": {
      "filled": true,
      "size": 35
    }
  }
}
